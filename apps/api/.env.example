# Conexão direta ao Postgres do Supabase (role `postgres`, ignora RLS —
# ver docs/database-schema.md, seção "Sobre NestJS e RLS"). O backend
# implementa as próprias checagens de posse.
# Para `supabase start` local, o valor padrão é:
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase Auth — projeto local (`supabase start`) ou remoto (Project Settings > API).
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY=""

# Service role key — usada apenas pelo AuthService para revogar a sessão
# no logout (auth.admin.signOut). Nunca expor ao frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Link de volta do e-mail de recuperação de senha (POST /auth/forgot-password).
# Precisa estar na allowlist de Redirect URLs do projeto Supabase.
PASSWORD_RESET_REDIRECT_URL="http://localhost:3000/reset-password"

PORT=3001
