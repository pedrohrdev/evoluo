// Schema Prisma do Evoluo.
//
// As tabelas entram neste arquivo conforme os módulos que as usam forem
// implementados (etapa 3: `profiles`; etapa 4: `challenges` e
// `challenge_participants`; etapa 5: `goals` e `goal_versions`; etapa 6:
// `daily_records`; etapa 7: `points_config` e `points_ledger`; etapa 8:
// `day_results`), para não antecipar funcionalidade fora do escopo de cada
// etapa. As demais tabelas já existem no banco (ver
// docs/database-schema.md) mas ainda não são usadas por nenhum módulo.
//
// `auth.users` é gerenciada pelo Supabase Auth e não é modelada aqui — o
// NestJS nunca escreve nela diretamente, só via Supabase Auth (SupabaseService).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @db.Uuid
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

// Status do participante dentro de um desafio específico (ver enum
// `participant_status` em supabase/migrations/20260905090100_enums.sql).
enum ParticipantStatus {
  active
  inactive

  @@map("participant_status")
}

model Challenge {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  description  String?
  durationDays Int      @map("duration_days")
  startDate    DateTime @map("start_date") @db.Date
  // Coluna gerada pelo banco (`generated always as ... stored`) — nunca
  // gravada pela aplicação. `dbgenerated()` sem argumento diz ao Prisma para
  // omitir esta coluna do INSERT/UPDATE e ler o valor calculado de volta via
  // RETURNING.
  endDate      DateTime @default(dbgenerated()) @map("end_date") @db.Date
  createdBy    String   @map("created_by") @db.Uuid
  // Gerado por `generate_join_code()` no banco — a aplicação nunca gera nem
  // sobrescreve o código, só lê o valor criado pelo default da coluna.
  joinCode     String   @unique @default(dbgenerated("generate_join_code()")) @map("join_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  participants ChallengeParticipant[]

  @@map("challenges")
}

model ChallengeParticipant {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId        String            @map("challenge_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  status             ParticipantStatus @default(active)
  joinedAt           DateTime          @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt             DateTime?         @map("left_at") @db.Timestamptz(6)
  // Campos agregados mantidos exclusivamente pelas funções de fechamento no
  // banco (streak/scoring — etapas futuras). A aplicação nunca escreve
  // nestes campos diretamente; RLS/GRANT por coluna também bloqueiam isso.
  currentStreak      Int               @default(0) @map("current_streak")
  longestStreak      Int               @default(0) @map("longest_streak")
  totalPoints        Int               @default(0) @map("total_points")
  totalDaysCompleted Int               @default(0) @map("total_days_completed")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge    Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  goals        Goal[]
  dailyRecords DailyRecord[]
  pointsLedger PointsLedger[]
  dayResults   DayResult[]

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

// Tipo da meta: como o valor realizado é interpretado e comparado ao alvo
// (ver enum `goal_kind` em supabase/migrations/20260905090100_enums.sql).
enum GoalKind {
  hours
  quantity
  boolean

  @@map("goal_kind")
}

// Periodicidade da meta. "challenge" é a meta de longo prazo cujo período é
// a duração inteira do desafio (ver enum `goal_period`).
enum GoalPeriod {
  daily
  weekly
  monthly
  challenge

  @@map("goal_period")
}

// Importância da meta, chave de `points_config` (etapas futuras de
// pontuação — ver enum `importance_level`).
enum ImportanceLevel {
  low
  medium
  high

  @@map("importance_level")
}

// Identidade estável da meta (a quem pertence, qual periodicidade). O
// conteúdo (tipo, importância, valor-alvo, título) vive em `GoalVersion` —
// ver docs/arquitetura-tecnica.md seção 4. `Goal` nunca é editada in-place.
model Goal {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeParticipantId String     @map("challenge_participant_id") @db.Uuid
  periodType             GoalPeriod @map("period_type")
  createdAt              DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  challengeParticipant ChallengeParticipant @relation(fields: [challengeParticipantId], references: [id], onDelete: Cascade)
  versions             GoalVersion[]
  dailyRecords         DailyRecord[]

  @@map("goals")
}

// Conteúdo da meta em cada momento — append-only por design (triggers
// `prevent_goal_version_mutation`/`prevent_goal_version_delete` no banco
// bloqueiam qualquer alteração de conteúdo ou apagamento). Editar uma meta
// = fechar a versão vigente (`validUntil`) e abrir uma nova, nunca UPDATE
// no conteúdo de uma versão existente — ver GoalsService.setVersion().
model GoalVersion {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId      String          @map("goal_id") @db.Uuid
  kind        GoalKind
  importance  ImportanceLevel
  title       String
  targetValue Decimal?        @map("target_value") @db.Decimal(10, 2)
  validFrom   DateTime        @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?       @map("valid_until") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  dailyRecords DailyRecord[]

  @@map("goal_versions")
}

// Um lançamento real de uma meta diária numa data. `completed` e
// `pointsAwarded` nunca são calculados pela aplicação — os triggers
// `compute_daily_record_fields`/`enforce_daily_record_window` do banco
// sobrescrevem esses campos e bloqueiam qualquer escrita fora do dia
// vigente (fuso America/Sao_Paulo). A aplicação nunca envia uma
// `recordDate` vinda do cliente — sempre "hoje", o que já torna a edição
// retroativa inexpressável por este caminho (RecordsService.recordToday).
model DailyRecord {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId                 String          @map("goal_id") @db.Uuid
  goalVersionId          String          @map("goal_version_id") @db.Uuid
  challengeParticipantId String          @map("challenge_participant_id") @db.Uuid
  recordDate             DateTime        @map("record_date") @db.Date
  actualValue            Decimal?        @map("actual_value") @db.Decimal(10, 2)
  actualBoolean          Boolean?        @map("actual_boolean")
  kind                   GoalKind
  importance             ImportanceLevel
  targetValueSnapshot    Decimal?        @map("target_value_snapshot") @db.Decimal(10, 2)
  completed              Boolean         @default(false)
  pointsAwarded          Int             @default(0) @map("points_awarded")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  goal                 Goal                 @relation(fields: [goalId], references: [id])
  goalVersion          GoalVersion          @relation(fields: [goalVersionId], references: [id])
  challengeParticipant ChallengeParticipant @relation(fields: [challengeParticipantId], references: [id], onDelete: Cascade)

  @@unique([goalId, recordDate])
  @@map("daily_records")
}

// Tabela de configuração de pontos por importância × período — a fonte da
// verdade usada pelos triggers compute_daily_record_fields/
// compute_period_record_fields para preencher `points_awarded`. Só
// leitura: trocar a escala é um UPDATE nesta tabela, nunca uma mudança de
// código (CLAUDE.md seção 2 "Pontos").
model PointsConfig {
  importance ImportanceLevel
  periodType GoalPeriod      @map("period_type")
  points     Int

  @@id([importance, periodType])
  @@map("points_config")
}

// Lançamento append-only de pontos — a trilha de auditoria de onde veio
// cada ponto. Gravado exclusivamente pelas funções de fechamento
// (security definer, etapa 8+); esta etapa só lê. `sourceTable` é `text`
// no banco (não um enum real), então fica como String aqui também.
model PointsLedger {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeParticipantId String   @map("challenge_participant_id") @db.Uuid
  sourceTable            String   @map("source_table")
  sourceRecordId         String   @map("source_record_id") @db.Uuid
  points                 Int
  awardedForDate         DateTime @map("awarded_for_date") @db.Date
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challengeParticipant ChallengeParticipant @relation(fields: [challengeParticipantId], references: [id], onDelete: Cascade)

  @@unique([sourceTable, sourceRecordId])
  @@map("points_ledger")
}

// Um por participante por dia. Durante o dia em curso é atualizada de
// forma "tentativa" a cada registro diário (trigger upsert_day_result,
// `closed = false`) só para exibir progresso em tempo real (ex.: "2/3
// hoje") — o streak em ChallengeParticipant.currentStreak só é atualizado
// de fato quando close_daily_period() fecha o dia (`closed = true`),
// nunca em tempo real, para o streak não oscilar durante o dia
// (docs/arquitetura-tecnica.md seção 3 "Day Evaluation"). Esta etapa só
// lê; nenhuma escrita aqui é feita pela aplicação.
model DayResult {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeParticipantId String   @map("challenge_participant_id") @db.Uuid
  resultDate             DateTime @map("result_date") @db.Date
  completedGoalsCount    Int      @default(0) @map("completed_goals_count")
  dayCompleted           Boolean  @default(false) @map("day_completed")
  streakAfter            Int?     @map("streak_after")
  closed                 Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  challengeParticipant ChallengeParticipant @relation(fields: [challengeParticipantId], references: [id], onDelete: Cascade)

  @@unique([challengeParticipantId, resultDate])
  @@map("day_results")
}
